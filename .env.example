NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server-only — needed for scripts/backfill-price-history.mjs and the
# /api/cron/update-prices route (see SETUP-PRICE-HISTORY.md). Never expose
# these with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here
CRON_SECRET=a_random_string_vercel_sends_back_to_authenticate_the_cron_job

# Source Postgres DB to migrate/sync price history from (see SETUP-PRICE-HISTORY.md).
# Used by scripts/migrate-from-source-db.mjs (one-time migration, run locally)
# and by /api/cron/update-prices (daily incremental sync). Never expose these
# with a NEXT_PUBLIC_ prefix.
SOURCE_PG_HOST=your_source_db_host
SOURCE_PG_PORT=5432
SOURCE_PG_DATABASE=your_source_db_name
SOURCE_PG_USER=your_source_db_user
SOURCE_PG_PASSWORD=your_source_db_password
